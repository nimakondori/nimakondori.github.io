<ul class="socials">
  {% if site.email %}
    <li>
      <a href="mailto:{{ site.email }}" aria-label="Email">
        <span class="socials__label">Email</span>
      </a>
    </li>
  {% endif %}
  {% if site.github_username %}
    <li>
      <a href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <span class="socials__label">GitHub</span>
      </a>
    </li>
  {% endif %}
  {% if site.linkedin_username %}
    <li>
      <a
        href="https://www.linkedin.com/in/{{ site.linkedin_username }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
      >
        <span class="socials__label">LinkedIn</span>
      </a>
    </li>
  {% endif %}
  {% if site.x_username %}
    <li>
      <a href="https://x.com/{{ site.x_username }}" target="_blank" rel="noopener noreferrer" aria-label="X">
        <span class="socials__label">X</span>
      </a>
    </li>
  {% endif %}
  {% if site.scholar_userid %}
    <li>
      <a
        href="https://scholar.google.com/citations?user={{ site.scholar_userid }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Google Scholar"
      >
        <span class="socials__label">Scholar</span>
      </a>
    </li>
  {% endif %}
</ul>

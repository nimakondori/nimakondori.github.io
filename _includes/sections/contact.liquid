<section class="section contact" id="contact">
  <div class="wrap">
    <p class="section__label" data-reveal>06 — Contact</p>

    <h2 class="contact__headline">
      <span class="line" data-split>Let's build</span>
      <span class="line" data-split><em>something</em></span>
    </h2>

    <a class="contact__email" href="mailto:{{ site.email }}" data-reveal data-magnetic>{{ site.email }}</a>

    <div class="contact__socials" data-reveal>
      {% include social.liquid %}
    </div>
  </div>
</section>

{% comment %}
  Archived entries (early student work) still have pages but are kept out of the
  featured grid. See the resume-alignment audit, §7.1.
{% endcomment %}
{% assign projects = site.projects | where_exp: "p", "p.archived != true" | sort: 'importance' %}

<section class="section work" id="work">
  <div class="wrap">
    <p class="section__label" data-reveal>03 / Work</p>
    <h2 class="section__title" data-reveal>Selected projects</h2>

    <div class="work__grid">
      {% for project in projects %}
        {% if project.redirect %}
          {% assign target = project.redirect %}
          {% assign external = true %}
        {% else %}
          {% assign target = project.url | relative_url %}
          {% assign external = false %}
        {% endif %}

        <a
          class="work-card"
          href="{{ target }}"
          {% if external %}target="_blank" rel="noopener noreferrer"{% endif %}
          data-reveal
          data-cursor="{% if external %}Open repo{% else %}Read more{% endif %}"
        >
          {% if project.img %}
            <div class="work-card__media">
              <img src="{{ project.img | relative_url }}" alt="{{ project.title }}" loading="lazy">
            </div>
          {% endif %}
          <div class="work-card__body">
            <span class="work-card__tag">{{ project.category }}</span>
            <h3 class="work-card__title">{{ project.title }}</h3>
            <p class="work-card__desc">{{ project.description }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

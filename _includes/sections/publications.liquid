<section class="section publications" id="publications">
  <div class="wrap">
    <p class="section__label" data-reveal>04 — Research</p>
    <h2 class="section__title" data-reveal>Published work</h2>

    <ol class="pub-list">
      {% bibliography %}
    </ol>

    <a
      class="btn btn--ghost"
      href="https://scholar.google.com/citations?user={{ site.scholar_userid }}"
      target="_blank"
      rel="noopener noreferrer"
      data-reveal
      data-magnetic
    >
      All publications on Google Scholar ↗
    </a>
  </div>
</section>

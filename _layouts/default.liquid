<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
  </head>

  <body>
    {% include scene_background.liquid %}
    {% include nav.liquid %}

    <main id="main">
      {{ content }}
    </main>

    {% include footer.liquid %}

    {% comment %}
      All deferred so nothing blocks the page. hero.js comes first: deferred
      scripts run in order, so the particle name never waits on the CDN.
    {% endcomment %}
    <script defer src="{{ '/assets/js/hero.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script defer src="{{ '/assets/js/motion.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
    {% include scripts/goatcounter.liquid %}
  </body>
</html>

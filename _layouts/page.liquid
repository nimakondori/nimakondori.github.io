---
layout: default
---

<article class="section page">
  <div class="wrap wrap--narrow">
    <h1 class="page__title" data-reveal>{{ page.title }}</h1>
    {% if page.description %}
      <p class="page__desc" data-reveal>{{ page.description }}</p>
    {% endif %}

    <div class="prose" data-reveal>
      {{ content }}
    </div>

    <a class="btn btn--ghost" href="{{ '/' | relative_url }}" data-magnetic>← Back home</a>
  </div>
</article>

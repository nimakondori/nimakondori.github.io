<li class="pub" data-reveal>
  <div class="pub__year">{{ entry.year }}</div>

  <div class="pub__main">
    <h3 class="pub__title">{{ entry.title }}</h3>

    {% if entry.author %}
      <p class="pub__authors">
        {% for author in entry.author_array %}
          {% assign author_name = author.first | append: ' ' | append: author.last %}
          {% if author.last == site.scholar.last_name[0] %}
            <span class="pub__me">{{ author_name }}</span>
          {% else %}
            {{ author_name }}
          {% endif %}
          {% unless forloop.last %}·{% endunless %}
        {% endfor %}
      </p>
    {% endif %}

    <p class="pub__venue">
      {% if entry.journal %}
        {{ entry.journal }}
      {% elsif entry.booktitle %}
        {{ entry.booktitle }}
      {% elsif entry.archiveprefix %}
        {{ entry.archiveprefix }}{% if entry.eprint %}:{{ entry.eprint }}{% endif %}
      {% endif %}
    </p>

    <div class="pub__links">
      {% if entry.html %}
        <a href="{{ entry.html }}" target="_blank" rel="noopener noreferrer">Paper ↗</a>
      {% elsif entry.url %}
        <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">Paper ↗</a>
      {% endif %}
      {% if entry.pdf %}
        <a href="{{ entry.pdf | relative_url }}" target="_blank" rel="noopener noreferrer">PDF ↗</a>
      {% endif %}
      {% if entry.code %}
        <a href="{{ entry.code }}" target="_blank" rel="noopener noreferrer">Code ↗</a>
      {% endif %}
    </div>
  </div>

  {% if entry.preview %}
    <div class="pub__preview">
      <img src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}" alt="" loading="lazy">
    </div>
  {% endif %}
</li>
